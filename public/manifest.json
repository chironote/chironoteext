{
  "manifest_version": 3,
  "name": "ChiroNote",
  "short_name": "ChiroNote",
  "version": "1.2.1",
  "description": "Record visits and move completed ChiroNote notes into your EHR without changing tabs.",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Open ChiroNote",
    "default_icon": {
      "16": "logo192.png",
      "32": "logo192.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": ["sidePanel"],
  "host_permissions": [
    "https://*.amazonaws.com/*",
    "https://*.on.aws/*"
  ],
  "icons": {
    "16": "logo192.png",
    "32": "logo192.png",
    "48": "logo192.png",
    "128": "logo192.png"
  }
}
